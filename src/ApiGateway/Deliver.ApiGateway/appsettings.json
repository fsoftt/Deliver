{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "shipments": {
        "ClusterId": "shipping",
        "Match": { "Path": "/api/shipments/{**catch-all}" }
      },
      "drivers": {
        "ClusterId": "fleet",
        "Match": { "Path": "/api/drivers/{**catch-all}" }
      },
      "dispatch": {
        "ClusterId": "dispatch",
        "Match": { "Path": "/api/dispatch/{**catch-all}" }
      },
      "billing": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/billing/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      }
    },
    "Clusters": {
      "shipping": { "Destinations": { "primary": { "Address": "http://localhost:5101" } } },
      "fleet": { "Destinations": { "primary": { "Address": "http://localhost:5102" } } },
      "dispatch": { "Destinations": { "primary": { "Address": "http://localhost:5103" } } },
      "billing": { "Destinations": { "primary": { "Address": "http://localhost:5104" } } },
      "notifications": { "Destinations": { "primary": { "Address": "http://localhost:5105" } } },
      "analytics": { "Destinations": { "primary": { "Address": "http://localhost:5106" } } }
    }
  }
}
